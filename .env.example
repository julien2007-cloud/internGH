# Copy this file to .env.local for local development (never commit .env.local),
# and add the same variables in Vercel → Project → Settings → Environment Variables.

# --- WhatsApp Cloud API (server-only secrets) ---
# Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; enter the same value when configuring the webhook in Meta
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard → App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=

# Optional
# WHATSAPP_API_VERSION=v25.0
# Approved template for the welcome message. Default is Meta's built-in hello_world.
# A custom template should have two body variables: {{1}} first name, {{2}} majors.
# WHATSAPP_WELCOME_TEMPLATE=interngh_welcome
# Approved template used when the 24-hour chat window is closed:
# {{1}} role, {{2}} organisation, {{3}} closes, {{4}} link
# WHATSAPP_ALERT_TEMPLATE=interngh_alert
# WHATSAPP_TEMPLATE_LANG=en_US
# Public URL of the site, used in links inside messages
# APP_URL=https://your-project.vercel.app

# --- Matching alerts (subscribers, shared postings, deadline reminders) ---
# Upstash Redis via Vercel → Storage / Marketplace sets these automatically
# (either the KV_ or UPSTASH_ names work). Without them, local dev keeps data in memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Secret code publishers enter to post to every student and send WhatsApp alerts
PUBLISHER_CODE=
# Protects the daily reminder job (Vercel Cron sends it automatically)
CRON_SECRET=
# Approved templates for business-initiated alerts (recommended in production):
# new posting: {{1}} role, {{2}} organisation, {{3}} pay, {{4}} closing date, {{5}} link
# WHATSAPP_MATCH_TEMPLATE=interngh_new_match
# deadline:    {{1}} role, {{2}} organisation, {{3}} when ("tomorrow"), {{4}} link
# WHATSAPP_DEADLINE_TEMPLATE=interngh_deadline
# Days before a deadline to remind (comma-separated)
# REMINDER_DAYS=3,1

# --- Public (shown in the browser) ---
# Your WhatsApp business number, digits only with country code, for the "Message InternGH" button
VITE_WHATSAPP_NUMBER=
